[Unit]
Description=Orchestrator Raft Power Failure Recovery
Documentation=file:///workspaces/orchestrator/POWER-FAILURE-RECOVERY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/workspaces/orchestrator/recover-from-power-failure.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

# 环境变量
Environment="ORCHESTRATOR_API=http://127.0.0.1:3000"
Environment="MYSQL_MASTER_HOST=127.0.0.1"
Environment="MYSQL_MASTER_PORT=3306"
Environment="MYSQL_USER=root"
Environment="MYSQL_PASS=root"
Environment="ALERT_EMAIL=admin@example.com"

[Install]
WantedBy=multi-user.target
